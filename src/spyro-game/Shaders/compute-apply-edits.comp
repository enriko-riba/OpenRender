#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct VoxelEdit {
    uint voxelIndex;
    uint blockType;
};

layout(std430, binding = 1) buffer VoxelDataBuffer {
    uint voxelData[];
};

layout(std430, binding = 5) readonly buffer EditBuffer {
    VoxelEdit edits[];
};

uniform uint uEditCount;
uniform uint uChunkIndexOffset; // Offset in voxelData (chunkIdx * voxelsPerChunk)

// Helper to pack voxel data (match compute-generate.comp)
uint packVoxel(uint blockType) {
    // If blockType is 0, we want 0.
    if (blockType == 0u) return 0u;
    // Otherwise pack with default flags (e.g. light=15)
    return blockType | (0u << 8) | (15u << 16) | (0u << 24);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uEditCount) return;

    VoxelEdit edit = edits[idx];

    // Apply edit to voxel data
    // UNPACKED: Direct write
    voxelData[edit.voxelIndex] = edit.blockType;
}
