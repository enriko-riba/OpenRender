#version 460
#extension GL_ARB_gpu_shader_int64 : require

// CRITICAL: Work group layout MUST match generation shader!
layout(local_size_x = 16, local_size_y = 1, local_size_z = 16) in;

// ============================================================================
// Constants (match VoxelHelper.cs)
// ============================================================================
// Constants and Block types are included from terrain-common.glsl

// Face bits (match order: +X, -X, +Y, -Y, +Z, -Z)
const uint FACE_POS_X = (1u << 0);
const uint FACE_NEG_X = (1u << 1);
const uint FACE_POS_Y = (1u << 2);
const uint FACE_NEG_Y = (1u << 3);
const uint FACE_POS_Z = (1u << 4);
const uint FACE_NEG_Z = (1u << 5);

// ============================================================================
// Uniforms
// ============================================================================
uniform uint uChunkCount;
uniform uint uSeed;
uniform uint uWorldChunksXZ;
uniform int uTestMode;

// ============================================================================
// SSBOs (using VoxelHelper.SSBOBindings constants)
// ============================================================================

// Input: Generated voxel data from Phase 2
layout(std430, binding = 0) readonly buffer VoxelData {
    uint voxelData[];  // Packed: blockType(8) | biomeID(8) | light(8) | flags(8)
};

// Output: Visibility mask (6 bits per voxel)
layout(std430, binding = 1) writeonly buffer VisibilityMask {
    uint visibilityMask[];  // lower 6 bits used
};

// Input: Chunk indices for neighbor calculation
layout(std430, binding = 6) readonly buffer ChunkIndicesBuffer {
    uint chunkIndices[];
};

struct WorldEdit {
    int x;
    int y;
    int z;
    uint type;
};

// Input: World edits for neighbor correction
layout(std430, binding = 7) readonly buffer WorldEditsBuffer {
    uint editCount;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    WorldEdit worldEdits[];
};

// ============================================================================
// Noise Functions (Included from terrain-common.glsl)
// ============================================================================

#include "terrain-common.glsl"

// ============================================================================
// Helper Functions
// ============================================================================

/// Check if voxel is transparent (air or water)
bool isTransparent(uint voxel) {
    uint blockType = voxel & 0xFFu;
    return blockType == BLOCK_NONE || blockType == BLOCK_WATER_LEVEL;
}

bool isWater(uint voxel) {
    uint blockType = voxel & 0xFFu;
    return blockType == BLOCK_WATER_LEVEL;
}

/// Get voxel at local coordinates (with bounds checking)
/// If out of bounds, calculate procedurally
uint getVoxel(uint chunkIdx, int lx, int ly, int lz) {
    // Check Y bounds first (always air above/below world)
    if (ly < 0 || ly >= CHUNK_Y_SIZE) return 0u; // Air

    // Check if inside current chunk
    if (lx >= 0 && lx < CHUNK_SIDE_SIZE && lz >= 0 && lz < CHUNK_SIDE_SIZE) {
        uint voxelIdx = chunkIdx * CHUNK_VOXEL_COUNT +
                        uint(lx) +
                        uint(lz) * CHUNK_SIDE_SIZE +
                        uint(ly) * CHUNK_SIDE_SIZE_SQUARED;
        return voxelData[voxelIdx];
    }

    // Out of bounds: Calculate procedurally
    uint chunkIndexGlobal = chunkIndices[chunkIdx];
    uint chunkX = chunkIndexGlobal % uWorldChunksXZ;
    uint chunkZ = chunkIndexGlobal / uWorldChunksXZ;
    
    // Calculate global world coordinates
    int wx = int(chunkX * CHUNK_SIDE_SIZE) + lx;
    int wz = int(chunkZ * CHUNK_SIDE_SIZE) + lz;

    // Check world edits first (linear scan - keep count low!)
    for (uint i = 0; i < editCount; i++) {
        if (worldEdits[i].x == wx && worldEdits[i].y == ly && worldEdits[i].z == wz) {
            return worldEdits[i].type;
        }
    }

    int height;
    if (uTestMode == 1) {
        // Replicate test mode logic
        int neighborChunkX = wx / CHUNK_SIDE_SIZE;
        int neighborChunkZ = wz / CHUNK_SIDE_SIZE;
        height = 40 + int((uint(neighborChunkX) + uint(neighborChunkZ)) % 8u);
    } else {
        height = generateHeight(wx, wz, uSeed);
    }

    // Note: compute-visibility doesn't include terrain-common.glsl directly but duplicates logic.
    // I should probably update the duplicated logic or include the file.
    // For now, I'll just update the call to match the signature if I can't include.
    // Wait, compute-visibility DOES NOT include terrain-common.glsl. It has its own copy of noise functions.
    // I need to update the local copy of generateBlockType or add the new one here.
    // Since I just removed the old one, I must add the new one!
    
    // Re-adding the new generateBlockType locally to compute-visibility.comp
    // But wait, I removed it in the previous step.
    // Let's add it back with the new logic.
    
    uint blockType = generateBlockType(height, ly, wx, wz, uSeed);
    return blockType; // We only need the block type for transparency check
}

// ============================================================================
// Main Shader
// ============================================================================

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    uint ly = gl_WorkGroupID.y;  // Y slice
    if (chunkIdx >= uChunkCount || ly >= CHUNK_Y_SIZE) return;

    int lx = int(gl_LocalInvocationID.x);
    int lz = int(gl_LocalInvocationID.z);

    uint voxelIdx = chunkIdx * CHUNK_VOXEL_COUNT +
                    uint(lx) +
                    uint(lz) * CHUNK_SIDE_SIZE +
                    ly * CHUNK_SIDE_SIZE_SQUARED;

    uint voxel = voxelData[voxelIdx];
    uint blockType = voxel & 0xFFu;

    if (blockType == BLOCK_NONE) {
        visibilityMask[voxelIdx] = 0u;
        return;
    }

    bool currentIsWater = (blockType == BLOCK_WATER_LEVEL);
    
    // Neighbor-based face visibility
    uint mask = 0u;

    // Helper macro for face checking
    #define CHECK_FACE(neighborVoxel, faceBit) \
    { \
        uint nv = neighborVoxel; \
        bool neighborIsWater = isWater(nv); \
        bool neighborIsTransparent = isTransparent(nv); \
        /* FIX: If we are deep underwater, assume Air neighbor is actually Water (error correction) */ \
        /* This fixes issues where getVoxel returns 0 for valid water blocks or boundary issues */ \
        if (currentIsWater && int(ly) < WATER_LEVEL - 1 && nv == BLOCK_NONE) { \
             neighborIsWater = true; \
        } \
        if (currentIsWater) { \
            /* Water only draws against Air (transparent but not water) */ \
            /* Also draw against other water if we want to see water-water boundaries? No. */ \
            if (neighborIsTransparent && !neighborIsWater) mask |= faceBit; \
        } else { \
            /* Solid blocks draw against any transparent block (Air OR Water) */ \
            /* If neighbor is water, it is transparent, so we draw the solid face. */ \
            if (neighborIsTransparent) mask |= faceBit; \
        } \
    }

    // +X
    CHECK_FACE(getVoxel(chunkIdx, lx + 1, int(ly), lz), FACE_POS_X);

    // -X
    CHECK_FACE(getVoxel(chunkIdx, lx - 1, int(ly), lz), FACE_NEG_X);

    // +Y
    CHECK_FACE(getVoxel(chunkIdx, lx, int(ly) + 1, lz), FACE_POS_Y);

    // -Y
    CHECK_FACE(getVoxel(chunkIdx, lx, int(ly) - 1, lz), FACE_NEG_Y);

    // +Z
    CHECK_FACE(getVoxel(chunkIdx, lx, int(ly), lz + 1), FACE_POS_Z);

    // -Z
    CHECK_FACE(getVoxel(chunkIdx, lx, int(ly), lz - 1), FACE_NEG_Z);

    if (currentIsWater) {
        mask |= (1u << 6); // Bit 6 = IsWater
    }

    visibilityMask[voxelIdx] = mask;
}
