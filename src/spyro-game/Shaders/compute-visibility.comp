#version 460
#extension GL_ARB_gpu_shader_int64 : require

// VERSION: 2024-01-15-v2 - Fixed redundant bounds check causing missing faces at chunk boundaries

// Restore original layout: process all 16 X columns directly (each invocation handles one column)
// OPTIMIZATION: Process 4 voxels per thread to enable packed writes (1 uint = 4 masks)
layout(local_size_x = 4, local_size_y = 1, local_size_z = 16) in;

// ============================================================================
// Constants (match VoxelHelper.cs)
// ============================================================================
// Constants and Block types are included from terrain-common.glsl

// Face bits (match order: +X, -X, +Y, -Y, +Z, -Z)
const uint FACE_POS_X = (1u << 0);
const uint FACE_NEG_X = (1u << 1);
const uint FACE_POS_Y = (1u << 2);
const uint FACE_NEG_Y = (1u << 3);
const uint FACE_POS_Z = (1u << 4);
const uint FACE_NEG_Z = (1u << 5);

// ============================================================================
// Uniforms
// ============================================================================
uniform uint uChunkCount;
// uniform uint uSeed; // Removed - using TerrainParams
uniform uint uWorldChunksXZ;
// uniform int uTestMode; // Removed

// ============================================================================
// SSBOs (using VoxelHelper.SSBOBindings constants)
// ============================================================================

// Input: Generated voxel data from Phase 2
layout(std430, binding = 0) readonly buffer VoxelData {
    uint voxelData[];  // Packed: blockType(8) | biomeID(8) | light(8) | flags(8)
};

// Output: Visibility mask (6 bits per voxel)
layout(std430, binding = 1) writeonly buffer VisibilityMask {
    uint visibilityMask[];  // lower 6 bits used
};

// Input: Chunk indices for neighbor calculation
layout(std430, binding = 9) readonly buffer ChunkIndicesBuffer {
    uint chunkIndices[];
};

struct WorldEdit {
    int x;
    int y;
    int z;
    uint type;
};

// Input: World edits for neighbor correction
layout(std430, binding = 7) readonly buffer WorldEditsBuffer {
    uint editCount;
    uint _pad0;
    uint _pad1;
    uint _pad2;
    WorldEdit worldEdits[];
};

// ============================================================================
// Noise Functions (Included from terrain-common.glsl)
// ============================================================================

#include "terrain-common.glsl"
#include "terrain-noise.glsl"
#include "terrain-caves.glsl"
#include "terrain-generation.glsl"  // For generateHeight() and generateBlockType()

// ============================================================================
// Helper Functions
// ============================================================================

uint packSimple(uint blockDescriptor)
{   // Pack minimal voxel (other fields zero) to mimic voxelData layout low 8 bits block descriptor
    return blockDescriptor & 0xFFu;
}

uint proceduralVoxel(int wx, int ly, int wz)
{
    int height = generateHeight(wx, wz);
    
    // CRITICAL FIX: Must match generateBlockType() EXACTLY for water!
    // generateBlockType() checks: if (y > height) then check for water
    if (ly > height) {
        // Above surface: check if underwater
        if (ly <= WATER_LEVEL) {
            return packSimple(BD_WATER);
        }
        return packSimple(BD_AIR);
    }
    
    // Solid blocks below surface
    uint blockDescriptor = generateBlockType(height, ly, wx, wz);
    return packSimple(blockDescriptor);
}

/// Check if voxel is transparent (air or water)
bool isTransparent(uint voxel) {
    uint blockDescriptor = voxel & 0xFFu;
    return blockDescriptor == BD_AIR || blockDescriptor == BD_WATER;
}

bool isWater(uint voxel) {
    uint blockDescriptor = voxel & 0xFFu;
    return blockDescriptor == BD_WATER;
}

/// Get voxel at local coordinates (with bounds checking)
/// If out of bounds, calculate procedurally (fast heightmap classification) instead of returning air.
uint getVoxel(uint chunkIdx, int lx, int ly, int lz) {
    if (ly < 0 || ly >= CHUNK_Y_SIZE) return packSimple(BD_AIR);

    if (lx >= 0 && lx < CHUNK_SIDE_SIZE && lz >= 0 && lz < CHUNK_SIDE_SIZE) {
        uint voxelIdx = chunkIdx * CHUNK_VOXEL_COUNT +
                        uint(lx) +
                        uint(lz) * CHUNK_SIDE_SIZE +
                        uint(ly) * CHUNK_SIDE_SIZE_SQUARED;
        return voxelData[voxelIdx];
    }

    uint chunkIndexGlobal = chunkIndices[chunkIdx];
    uint chunkX = chunkIndexGlobal % uWorldChunksXZ;
    uint chunkZ = chunkIndexGlobal / uWorldChunksXZ;

    int wx = int(chunkX) * CHUNK_SIDE_SIZE + lx;
    int wz = int(chunkZ) * CHUNK_SIDE_SIZE + lz;

    // Compute neighbor chunk coords with floor division for negatives
    int neighborChunkX = (wx >= 0) ? (wx / CHUNK_SIDE_SIZE) : ((wx - (CHUNK_SIDE_SIZE - 1)) / CHUNK_SIDE_SIZE);
    int neighborChunkZ = (wz >= 0) ? (wz / CHUNK_SIDE_SIZE) : ((wz - (CHUNK_SIDE_SIZE - 1)) / CHUNK_SIDE_SIZE);

    if (neighborChunkX >= 0 && neighborChunkX < int(uWorldChunksXZ) &&
        neighborChunkZ >= 0 && neighborChunkZ < int(uWorldChunksXZ)) {
        uint neighborGlobalIdx = uint(neighborChunkX) + uint(neighborChunkZ) * uWorldChunksXZ;
        // Look for neighbor in current batch
        for (uint i = 0; i < uChunkCount; i++) {
            if (chunkIndices[i] == neighborGlobalIdx) {
                // Local coords inside neighbor chunk
                int nlx = wx - neighborChunkX * CHUNK_SIDE_SIZE;
                int nlz = wz - neighborChunkZ * CHUNK_SIDE_SIZE;
                
                // CRITICAL: Verify local coords are in bounds before reading buffer
                if (nlx >= 0 && nlx < CHUNK_SIDE_SIZE && nlz >= 0 && nlz < CHUNK_SIDE_SIZE) {
                    uint neighborVoxelIdx = i * CHUNK_VOXEL_COUNT +
                                           uint(nlx) +
                                           uint(nlz) * CHUNK_SIDE_SIZE +
                                           uint(ly) * CHUNK_SIDE_SIZE_SQUARED;
                    return voxelData[neighborVoxelIdx];
                }
                // If out of bounds, fall through to procedural
                break;
            }
        }
    }

    // Procedural fallback (prevents vertical opaque walls & missing corner faces)
    return proceduralVoxel(wx, ly, wz);
}

// ============================================================================
// Main Shader
// ============================================================================

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    uint ly = gl_WorkGroupID.y;  // Y slice
    if (chunkIdx >= uChunkCount || ly >= CHUNK_Y_SIZE) return;

    // Each thread processes 4 voxels along X
    int lx_base = int(gl_LocalInvocationID.x) * 4;
    int lz = int(gl_LocalInvocationID.z);

    uint packedMask = 0u;

    // Unroll loop for 4 voxels
    for (int i = 0; i < 4; i++) {
        int lx = lx_base + i;
        
        uint voxelIdx = chunkIdx * CHUNK_VOXEL_COUNT +
                        uint(lx) +
                        uint(lz) * CHUNK_SIDE_SIZE +
                        ly * CHUNK_SIDE_SIZE_SQUARED;

        uint voxel = voxelData[voxelIdx];
        uint blockDescriptor = voxel & 0xFFu;

        if (blockDescriptor == BD_AIR) {
            // Mask is 0, no need to OR anything
            continue;
        }

        bool currentIsWater = (blockDescriptor == BD_WATER);
        
        // Neighbor-based face visibility
        uint mask = 0u;

        // Helper macro for face checking
        #define CHECK_FACE(neighborVoxel, faceBit) \
        { \
            uint nv = neighborVoxel; \
            bool neighborIsWater = isWater(nv); \
            bool neighborIsTransparent = isTransparent(nv); \
            /* Water face culling: Water only renders faces against Air (not against other water) */ \
            if (currentIsWater) { \
                /* Only draw water face if neighbor is Air (transparent AND not water) */ \
                if (neighborIsTransparent && !neighborIsWater) mask |= faceBit; \
            } else { \
                /* Solid blocks draw against any transparent block (Air OR Water) */ \
                if (neighborIsTransparent) mask |= faceBit; \
            } \
        }

        // +X
        CHECK_FACE(getVoxel(chunkIdx, lx + 1, int(ly), lz), FACE_POS_X);

        // -X
        CHECK_FACE(getVoxel(chunkIdx, lx - 1, int(ly), lz), FACE_NEG_X);

        // +Y
        CHECK_FACE(getVoxel(chunkIdx, lx, int(ly) + 1, lz), FACE_POS_Y);

        // -Y
        CHECK_FACE(getVoxel(chunkIdx, lx, int(ly) - 1, lz), FACE_NEG_Y);

        // +Z
        CHECK_FACE(getVoxel(chunkIdx, lx, int(ly), lz + 1), FACE_POS_Z);

        // -Z
        CHECK_FACE(getVoxel(chunkIdx, lx, int(ly), lz - 1), FACE_NEG_Z);

        if (currentIsWater) {
            mask |= (1u << 6); // Bit 6 = IsWater
        }

        // Pack into uint (8 bits per voxel)
        packedMask |= (mask << (i * 8));
    }

    // Write packed mask (1 uint per 4 voxels)
    // Calculate index of the packed uint
    // Base voxel index for lx_base
    uint baseVoxelIdx = chunkIdx * CHUNK_VOXEL_COUNT +
                        uint(lx_base) +
                        uint(lz) * CHUNK_SIDE_SIZE +
                        ly * CHUNK_SIDE_SIZE_SQUARED;
    
    // Since we pack 4 consecutive X values, and X is the fastest varying index (stride 1),
    // the packed index is simply baseVoxelIdx / 4.
    visibilityMask[baseVoxelIdx >> 2] = packedMask;
}
