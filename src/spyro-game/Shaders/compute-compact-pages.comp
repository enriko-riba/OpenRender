#version 460

// Minimal paged compaction placeholder: emits one draw per chunk using current bases/counts.
// This serves as a stepping stone to a true multi-page allocator.

layout(std430, binding = 2) readonly buffer ssbo_chunk_indices { int chunkIndices[]; };
layout(std430, binding = 3) readonly buffer ssbo_column_heights { uint columnHeights[]; };
layout(std430, binding = 7) readonly buffer ssbo_bases { int bases[]; };
layout(std430, binding = 6) readonly buffer ssbo_counts { int counts[]; };

// Prepared draw buffers authored by compute
struct DrawData {
    mat4 model;
    vec4 chunkPos;
    int blocksBase;
    int chunkSize;
    int outlinedLocalIndex;
    int enabled;
};
layout(std430, binding = 5) writeonly buffer ssbo_drawData { DrawData draws[]; };

// Indirect commands buffer (treated as SSBO here; also bound to GL_DRAW_INDIRECT_BUFFER at draw time)
struct IndirectCmd { uint Count; uint InstanceCount; uint FirstIndex; uint BaseVertex; uint BaseInstance; };
layout(std430, binding = 12) writeonly buffer ssbo_indirect { IndirectCmd cmds[]; };

// Coherent draw count (binding 15)
layout(std430, binding = 15) coherent buffer ssbo_drawCount { uint drawCount; };

uniform int worldChunksXZ;
uniform int chunkSize;
uniform int indexCountPerVoxel;

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint gid = gl_GlobalInvocationID.x; // one chunk per thread
    if (gid >= drawCount) return; // drawCount used as input count here (set by CPU), then overwritten by us below

    int chunkIndex = chunkIndices[gid];
    int cx = chunkIndex % worldChunksXZ;
    int cz = chunkIndex / worldChunksXZ;
    vec3 pos = vec3(cx * chunkSize, 0, cz * chunkSize);

    int base = bases[gid];
    int cnt  = counts[gid];
    if (cnt < 0) cnt = 0;

    // Write per-draw data
    draws[gid].model = mat4(1.0);
    draws[gid].model[3].xyz = pos;
    draws[gid].chunkPos = vec4(pos, 1.0);
    draws[gid].blocksBase = base;
    draws[gid].chunkSize = chunkSize;
    draws[gid].outlinedLocalIndex = -1;
    draws[gid].enabled = 1;

    // Write indirect command
    cmds[gid].Count = uint(indexCountPerVoxel);
    cmds[gid].InstanceCount = uint(cnt);
    cmds[gid].FirstIndex = 0u;
    cmds[gid].BaseVertex = 0u;
    cmds[gid].BaseInstance = gid;

    // Last thread writes final drawCount (equals input count)
    if (gid == drawCount - 1u) {
        // no-op; drawCount already equals the logical number of draws
    }
}

