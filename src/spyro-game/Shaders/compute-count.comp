// compute-count.comp - Phase 3.2: Count Visible Faces
// Purpose: Count total visible faces per chunk for prefix sum calculation
// Version: 1.0
//
// This shader performs a simple reduction: sum the popcount of all visibility
// masks in each chunk to determine how many faces will be rendered.

#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Constants
// ============================================================================
const int CHUNK_SIDE_SIZE = 16;
const int CHUNK_Y_SIZE = 128;
const int CHUNK_SIDE_SIZE_SQUARED = CHUNK_SIDE_SIZE * CHUNK_SIDE_SIZE;
const int CHUNK_VOXEL_COUNT = CHUNK_SIDE_SIZE_SQUARED * CHUNK_Y_SIZE;
const int WATER_LEVEL = 35;

// ============================================================================
// Uniforms
// ============================================================================
uniform uint uChunkCount;

// ============================================================================
// SSBOs (using VoxelHelper.SSBOBindings constants)
// ============================================================================

// Input: Visibility mask from Stage 3.1
layout(std430, binding = 1) readonly buffer VisibilityMask {
    uint visibilityMask[];
};

// Output: Visible face count per chunk
layout(std430, binding = 2) writeonly buffer VisibleCounts {
    uint visibleCounts[];
};

// Output: Opaque face count per chunk (for split draw calls)
layout(std430, binding = 12) writeonly buffer OpaqueCounts {
    uint opaqueCounts[];
};

// ============================================================================
// Main Shader
// ============================================================================

void main() {
    uint chunkIdx = gl_GlobalInvocationID.x;
    if (chunkIdx >= uChunkCount) return;

    uint baseIdx = chunkIdx * CHUNK_VOXEL_COUNT;
    uint totalCount = 0u;
    uint opaqueCount = 0u;

    // Count visible faces in this chunk
    // popcount (bitCount in GLSL) counts number of set bits
    for (uint i = 0u; i < CHUNK_VOXEL_COUNT; i++) {
        uint mask = visibilityMask[baseIdx + i];
        uint faces = uint(bitCount(mask & 0x3Fu)); // Only lower 6 bits are faces
        
        if (faces > 0u) {
            totalCount += faces;
            bool isWater = ((mask >> 6) & 1u) != 0u;
            
            if (!isWater) {
                opaqueCount += faces;
            }
        }
    }

    visibleCounts[chunkIdx] = totalCount;
    
    // Fallback: if we found visible faces but opaque count is 0, force it to totalCount.
    if (totalCount > 0u && opaqueCount == 0u) {
        opaqueCount = totalCount;
    }
    
    opaqueCounts[chunkIdx] = opaqueCount;
}
