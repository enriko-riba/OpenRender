#version 460
// compute-compact.comp - Phase 3.4: Mesh Compaction
// Purpose: Build compact vertex buffer from visible faces
// Version: 4.0 (Phase 5.3: Per-chunk index buffers - one command per chunk)
//
// Phase 5.3: Per-Chunk Index Buffers - generates indices per face (restored efficient batching)
// Phase 5.2: Face Index Encoding - removed normal vectors (saved memory)
//
// New vertex layout: position(12) + texCoord(8) + ao(4) + faceIndex(4) = 28 bytes
// Old vertex layout: position(12) + normal(12) + texCoord(8) + ao(4) = 36 bytes
// Savings: 8 bytes per vertex = 22 percent reduction
//
// PHASE 5.3 KEY CHANGE:
// Now generates 6 indices per face (not shared across faces)
// Enables one indirect command per chunk instead of per face
// Result: ~1000 commands instead of 2.5M for full terrain

#include "terrain-common.glsl"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 16) in;

// ============================================================================
// Constants
// ============================================================================

// Face indices
const uint FACE_POS_X = 0u;
const uint FACE_NEG_X = 1u;
const uint FACE_POS_Y = 2u;
const uint FACE_NEG_Y = 3u;
const uint FACE_POS_Z = 4u;
const uint FACE_NEG_Z = 5u;

// Texture atlas layout: 3 columns x 1 row (Simplified)
// Order (left->right): top, bottom, side
const float ATLAS_COLS = 3.0;
const float ATLAS_ROWS = 1.0;
const vec2 TILE_SIZE = vec2(1.0 / ATLAS_COLS, 1.0 / ATLAS_ROWS);

// ============================================================================
// Uniforms
// ============================================================================
uniform uint uChunkCount;
uniform uint uWorldChunksXZ;  // For calculating chunk world position
// uniform int uTestMode; // Removed
uniform uint uVertexRegionOffset; // start vertex index for this batch region
uniform uint uIndexRegionOffset;  // start index for this batch region

// ============================================================================
// SSBOs (using VoxelHelper.SSBOBindings constants)
// ============================================================================

// Input: Chunk indices
layout(std430, binding = 9) readonly buffer ChunkIndices {
    uint chunkIndices[];
};

// Input: Voxel data (Packed)
layout(std430, binding = 0) readonly buffer VoxelData {
    uint voxelData[];
};

// Input: Visibility mask (Packed)
layout(std430, binding = 1) readonly buffer VisibilityMask {
    uint visibilityMask[];
};

// Input: Base offsets (from prefix sum)
layout(std430, binding = 3) readonly buffer BaseOffsets {
    uint baseOffsets[];
};

// Output: Compacted vertices (Phase 5.2: position, texCoord, ao, faceIndex)
layout(std430, binding = 4) writeonly buffer CompactVertices {
    // vec3 pos, vec2 uv, float ao, uint faceIdx = 7 floats = 28 bytes
    // faceIndex stored as float via uintBitsToFloat for simpler buffer layout
    float compactVertices[];
};

// PHASE 5.3: Per-chunk index buffer (restored for efficient batching)
layout(std430, binding = 7) writeonly buffer CompactIndices {
    uint compactIndices[];
};

layout(std430, binding = 8) buffer PerChunkEmit {
    uint perChunkEmit[];
}; // per-chunk face emission counters

// Input: Opaque counts (from compute-count)
layout(std430, binding = 12) readonly buffer OpaqueCounts {
    uint opaqueCounts[];
};

// Atomic counters for water emission
layout(std430, binding = 14) buffer WaterEmit {
    uint waterEmit[];
};

// Atomic counters
layout(std430, binding = 5) buffer AtomicCounters {
    uint vertexCounter;
    uint indexCounter;
    uint faceCounter;
};

// Shared memory for workgroup reduction
shared uint s_OpaqueCount;
shared uint s_WaterCount;
shared uint s_OpaqueBase;
shared uint s_WaterBase;

struct WorldEdit {
    int x, y, z, type;
};

layout(std430, binding = 13) readonly buffer WorldEdits {
    int editCount;
    int _pad1, _pad2, _pad3;
    WorldEdit edits[];
};

// ============================================================================
// Helper Functions
// ============================================================================

int getBlockFromEdits(int wx, int wy, int wz) {
    for (int i = 0; i < editCount; i++) {
        if (edits[i].x == wx && edits[i].y == wy && edits[i].z == wz) {
            return edits[i].type;
        }
    }
    return -1; // Not found
}

vec3 getFaceNormal(uint face) {
    if (face == FACE_POS_X) return vec3(1, 0, 0);
    if (face == FACE_NEG_X) return vec3(-1, 0, 0);
    if (face == FACE_POS_Y) return vec3(0, 1, 0);
    if (face == FACE_NEG_Y) return vec3(0, -1, 0);
    if (face == FACE_POS_Z) return vec3(0, 0, 1);
    if (face == FACE_NEG_Z) return vec3(0, 0, -1);
    return vec3(0, 1, 0);
}

void getFaceCorners(uint face, vec3 pos, out vec3 corners[4]) {
    if (face == FACE_POS_X) {
        corners[0] = pos + vec3(1, 0, 0);
        corners[1] = pos + vec3(1, 1, 0);
        corners[2] = pos + vec3(1, 1, 1);
        corners[3] = pos + vec3(1, 0, 1);
    }
    else if (face == FACE_NEG_X) {
        corners[0] = pos + vec3(0, 0, 1);
        corners[1] = pos + vec3(0, 1, 1);
        corners[2] = pos + vec3(0, 1, 0);
        corners[3] = pos + vec3(0, 0, 0);
    }
    else if (face == FACE_POS_Y) {
        corners[0] = pos + vec3(0, 1, 0);
        corners[1] = pos + vec3(0, 1, 1);
        corners[2] = pos + vec3(1, 1, 1);
        corners[3] = pos + vec3(1, 1, 0);
    }
    else if (face == FACE_NEG_Y) {
        corners[0] = pos + vec3(0, 0, 1);
        corners[1] = pos + vec3(0, 0, 0);
        corners[2] = pos + vec3(1, 0, 0);
        corners[3] = pos + vec3(1, 0, 1);
    }
    else if (face == FACE_POS_Z) {
        corners[0] = pos + vec3(1, 0, 1);
        corners[1] = pos + vec3(1, 1, 1);
        corners[2] = pos + vec3(0, 1, 1);
        corners[3] = pos + vec3(0, 0, 1);
    }
    else if (face == FACE_NEG_Z) {
        corners[0] = pos + vec3(0, 0, 0);
        corners[1] = pos + vec3(0, 1, 0);
        corners[2] = pos + vec3(1, 1, 0);
        corners[3] = pos + vec3(1, 0, 0);
    }
}

vec2 getBaseUV(uint corner) {
    if (corner == 0u) return vec2(0, 1);
    if (corner == 1u) return vec2(0, 0);
    if (corner == 2u) return vec2(1, 0);
    if (corner == 3u) return vec2(1, 1);
    return vec2(0, 0);
}

vec2 flipV(vec2 uv) { return vec2(uv.x, 1.0 - uv.y); }

ivec2 faceToTile(uint face) {
    if (face == FACE_POS_Y) return ivec2(0, 0); // Top
    if (face == FACE_NEG_Y) return ivec2(1, 0); // Bottom
    return ivec2(2, 0); // Side (Front, Back, Left, Right)
}

vec2 getAtlasUV(uint face, uint corner) {
    vec2 uv = getBaseUV(corner);
    ivec2 tile = faceToTile(face);
    vec2 offset = vec2(float(tile.x) / ATLAS_COLS, float(tile.y) / ATLAS_ROWS);
    vec2 finalUv = offset + uv * TILE_SIZE;
    return flipV(finalUv);
}

bool isSolid(ivec3 pos, uint chunkIdx, vec3 chunkWorldOffset) {
    if (pos.y < 0) return true; // Bottom is solid
    if (pos.y >= CHUNK_Y_SIZE) return false; // Top is air

    // Check if inside current chunk
    if (pos.x >= 0 && pos.x < CHUNK_SIDE_SIZE && pos.z >= 0 && pos.z < CHUNK_SIDE_SIZE) {
        uint voxelIdx = chunkIdx * uint(CHUNK_VOXEL_COUNT) + uint(pos.x) + uint(pos.z) * uint(CHUNK_SIDE_SIZE) + uint(pos.y) * uint(CHUNK_SIDE_SIZE_SQUARED);
        uint voxel = getPackedVoxel(voxelIdx, voxelData);
        // Water is NOT solid for AO purposes (it doesn't occlude solid blocks)
        return (voxel & 0xFFu) > BLOCK_WATER_LEVEL;
    } 
    
    // Outside current chunk - try to find neighbor in current batch
    uint currentGlobalIdx = chunkIndices[chunkIdx];
    int chunkX = int(currentGlobalIdx % uWorldChunksXZ);
    int chunkZ = int(currentGlobalIdx / uWorldChunksXZ);
    
    int nChunkX = chunkX;
    int nChunkZ = chunkZ;
    int localX = pos.x;
    int localZ = pos.z;
    
    if (pos.x < 0) { nChunkX--; localX += CHUNK_SIDE_SIZE; }
    else if (pos.x >= CHUNK_SIDE_SIZE) { nChunkX++; localX -= CHUNK_SIDE_SIZE; }
    
    if (pos.z < 0) { nChunkZ--; localZ += CHUNK_SIDE_SIZE; }
    else if (pos.z >= CHUNK_SIDE_SIZE) { nChunkZ++; localZ -= CHUNK_SIDE_SIZE; }
    
    // Check world bounds
    if (nChunkX >= 0 && nChunkX < int(uWorldChunksXZ) && nChunkZ >= 0 && nChunkZ < int(uWorldChunksXZ)) {
        uint nGlobalIdx = uint(nChunkX + nChunkZ * int(uWorldChunksXZ));
        
        // Linear search in batch (batch size is small, ~64)
        for (uint i = 0u; i < uChunkCount; i++) {
            if (chunkIndices[i] == nGlobalIdx) {
                // Found neighbor in batch! Read its data.
                uint voxelIdx = i * uint(CHUNK_VOXEL_COUNT) + uint(localX) + uint(localZ) * uint(CHUNK_SIDE_SIZE) + uint(pos.y) * uint(CHUNK_SIDE_SIZE_SQUARED);
                uint voxel = getPackedVoxel(voxelIdx, voxelData);
                return (voxel & 0xFFu) > BLOCK_WATER_LEVEL;
            }
        }
    }

    // Fallback: Outside chunk and not in batch - use procedural generation
    int wx = int(chunkWorldOffset.x) + pos.x;
    int wz = int(chunkWorldOffset.z) + pos.z;
    int wy = pos.y;

    // Check edits first
    int editType = getBlockFromEdits(wx, wy, wz);
    if (editType != -1) {
        return editType > int(BLOCK_WATER_LEVEL);
    }

    int height;
    height = generateHeight(wx, wz);
    
    // Procedural: Solid if y <= height AND not water level
    // generateBlockType returns WATER for y <= WATER_LEVEL.
    // So if y <= WATER_LEVEL, it is water (not solid).
    // If y > WATER_LEVEL and y <= height, it is solid.
    // Wait, generateBlockType returns SAND for y < WATER_LEVEL - 2.
    // So deep underwater is solid.
    // But for simple AO, let's assume water level is water.
    // FIX: Underwater terrain (Sand/Bedrock) IS solid.
    // The previous check (pos.y <= WATER_LEVEL) return false; was wrong because it treated underwater solids as water.
    // generateBlockType logic:
    // y > height -> Water (if y<=WL) or Air. Both non-solid.
    // y <= height -> Sand/Bedrock/Grass. All solid.
    
    // M3: Check for caves in procedural fallback
    // This fixes AO artifacts at chunk boundaries where caves cross chunks
    if (pos.y <= height && pos.y > 0) {
        int depth = height - pos.y;
        float slope = 0.0;
        if (depth < 12) {
            slope = getSlope(wx, wz);
        }
        if (isCave(wx, pos.y, wz, depth, slope)) {
            return false; // Cave is air (not solid)
        }
    }

    return pos.y <= height;
}

float calculateAO(uint face, uint corner, uint chunkIdx, vec3 chunkWorldOffset, ivec3 p) {
    ivec3 o1, o2, o3;
    
    if (face == FACE_POS_Y) { // Top
        if (corner == 0u) { o1=ivec3(-1,1,0); o2=ivec3(0,1,-1); o3=ivec3(-1,1,-1); }
        else if (corner == 1u) { o1=ivec3(-1,1,0); o2=ivec3(0,1,1); o3=ivec3(-1,1,1); }
        else if (corner == 2u) { o1=ivec3(1,1,0); o2=ivec3(0,1,1); o3=ivec3(1,1,1); }
        else { o1=ivec3(1,1,0); o2=ivec3(0,1,-1); o3=ivec3(1,1,-1); }
    }
    else if (face == FACE_NEG_Y) { // Bottom
        if (corner == 0u) { o1=ivec3(-1,-1,0); o2=ivec3(0,-1,1); o3=ivec3(-1,-1,1); }
        else if (corner == 1u) { o1=ivec3(-1,-1,0); o2=ivec3(0,-1,-1); o3=ivec3(-1,-1,-1); }
        else if (corner == 2u) { o1=ivec3(1,-1,0); o2=ivec3(0,-1,-1); o3=ivec3(1,-1,-1); }
        else { o1=ivec3(1,-1,0); o2=ivec3(0,-1,1); o3=ivec3(1,-1,1); }
    }
    else if (face == FACE_POS_Z) { // Front
        if (corner == 0u) { o1=ivec3(1,0,1); o2=ivec3(0,-1,1); o3=ivec3(1,-1,1); }
        else if (corner == 1u) { o1=ivec3(1,0,1); o2=ivec3(0,1,1); o3=ivec3(1,1,1); }
        else if (corner == 2u) { o1=ivec3(-1,0,1); o2=ivec3(0,1,1); o3=ivec3(-1,1,1); }
        else { o1=ivec3(-1,0,1); o2=ivec3(0,-1,1); o3=ivec3(-1,-1,1); }
    }
    else if (face == FACE_NEG_Z) { // Back
        if (corner == 0u) { o1=ivec3(-1,0,-1); o2=ivec3(0,-1,-1); o3=ivec3(-1,-1,-1); }
        else if (corner == 1u) { o1=ivec3(-1,0,-1); o2=ivec3(0,1,-1); o3=ivec3(-1,1,-1); }
        else if (corner == 2u) { o1=ivec3(1,0,-1); o2=ivec3(0,1,-1); o3=ivec3(1,1,-1); }
        else { o1=ivec3(1,0,-1); o2=ivec3(0,-1,-1); o3=ivec3(1,-1,-1); }
    }
    else if (face == FACE_POS_X) { // Right
        if (corner == 0u) { o1=ivec3(1,-1,0); o2=ivec3(1,0,-1); o3=ivec3(1,-1,-1); }
        else if (corner == 1u) { o1=ivec3(1,1,0); o2=ivec3(1,0,-1); o3=ivec3(1,1,-1); }
        else if (corner == 2u) { o1=ivec3(1,1,0); o2=ivec3(1,0,1); o3=ivec3(1,1,1); }
        else { o1=ivec3(1,-1,0); o2=ivec3(1,0,1); o3=ivec3(1,-1,1); }
    }
    else { // Left (FACE_NEG_X)
        if (corner == 0u) { o1=ivec3(-1,-1,0); o2=ivec3(-1,0,1); o3=ivec3(-1,-1,1); }
        else if (corner == 1u) { o1=ivec3(-1,1,0); o2=ivec3(-1,0,1); o3=ivec3(-1,1,1); }
        else if (corner == 2u) { o1=ivec3(-1,1,0); o2=ivec3(-1,0,-1); o3=ivec3(-1,1,-1); }
        else { o1=ivec3(-1,-1,0); o2=ivec3(-1,0,-1); o3=ivec3(-1,-1,-1); }
    }

    bool s1 = isSolid(p + o1, chunkIdx, chunkWorldOffset);
    bool s2 = isSolid(p + o2, chunkIdx, chunkWorldOffset);
    bool s3 = isSolid(p + o3, chunkIdx, chunkWorldOffset);

    if (s1 && s2) return 0.33;
    int count = (s1?1:0) + (s2?1:0) + (s3?1:0);
    if (count == 0) return 1.0;
    if (count == 1) return 0.8;
    if (count == 2) return 0.6;
    return 0.4;
}

void writeVertex(uint vertexIdx, vec3 position, vec2 uv, float ao, uint faceIdx) {
    uint baseIdx = vertexIdx * 7u;
    compactVertices[baseIdx + 0u] = position.x;
    compactVertices[baseIdx + 1u] = position.y;
    compactVertices[baseIdx + 2u] = position.z;
    compactVertices[baseIdx + 3u] = uv.x;
    compactVertices[baseIdx + 4u] = uv.y;
    compactVertices[baseIdx + 5u] = ao;
    compactVertices[baseIdx + 6u] = uintBitsToFloat(faceIdx);
}

// ============================================================================
// Main Shader
// ============================================================================

void main(){
    // Initialize shared counters
    if (gl_LocalInvocationIndex == 0u) {
        s_OpaqueCount = 0u;
        s_WaterCount = 0u;
    }
    barrier();

    uint chunkIdx = gl_WorkGroupID.x;
    uint workGroupY = gl_WorkGroupID.y;
    if(chunkIdx>=uChunkCount||workGroupY>=uint(CHUNK_Y_SIZE)) return;
    
    uint actualChunkIdx = chunkIndices[chunkIdx];
    uint chunkX = actualChunkIdx % uWorldChunksXZ;
    uint chunkZ = actualChunkIdx / uWorldChunksXZ;
    vec3 chunkWorldOffset = vec3(float(chunkX*CHUNK_SIDE_SIZE),0.0,float(chunkZ*CHUNK_SIDE_SIZE));
    
    int lx=int(gl_LocalInvocationID.x);
    int lz=int(gl_LocalInvocationID.z);
    int ly=int(workGroupY);

    // Calculate voxel index (UNPACKED)
    // voxelIdx = chunk * VOXELS + lx + lz*SIDE + ly*SIDE*SIDE
    uint voxelIdx = chunkIdx*uint(CHUNK_VOXEL_COUNT)+uint(lx)+uint(lz)*uint(CHUNK_SIDE_SIZE)+uint(ly)*uint(CHUNK_SIDE_SIZE_SQUARED);
    
    uint voxel = voxelData[voxelIdx]; // Direct access
    uint blockType = voxel & 0xFFu;
    
    uint mask = visibilityMask[voxelIdx]; // Direct access
    
    // Early exit if no faces visible
    // Note: We can't return early because we need to participate in barrier() later!
    // So we use a flag.
    bool hasFaces = (mask != 0u && blockType != 0u);
    bool isWater = (blockType == BLOCK_WATER_LEVEL);
    uint faceCount = 0u;
    
    if (hasFaces) {
        faceCount = uint(bitCount(mask & 0x3Fu));
        
        // Atomic add to shared memory
        if (faceCount > 0u) {
            if (isWater) {
                atomicAdd(s_WaterCount, faceCount);
            } else {
                atomicAdd(s_OpaqueCount, faceCount);
            }
        }
    }
    
    barrier();
    
    // Allocate global space for the workgroup
    if (gl_LocalInvocationIndex == 0u) {
        if (s_OpaqueCount > 0u) {
            s_OpaqueBase = atomicAdd(perChunkEmit[chunkIdx], s_OpaqueCount);
        }
        if (s_WaterCount > 0u) {
            // Water starts after opaque faces. 
            // But perChunkEmit tracks opaque faces?
            // No, perChunkEmit tracks opaque faces.
            // waterEmit tracks water faces.
            // We need to add opaqueCount (total opaque faces in chunk) to water index?
            // In original code:
            // if (isWater) localFaceIdx = opaqueCount + atomicAdd(waterEmit[chunkIdx], 1u);
            // else localFaceIdx = atomicAdd(perChunkEmit[chunkIdx], 1u);
            
            // So we need to read opaqueCounts[chunkIdx] to offset water.
            // But opaqueCounts is constant for the chunk.
            // So s_WaterBase should be relative to waterEmit, and we add opaqueCount later.
            s_WaterBase = atomicAdd(waterEmit[chunkIdx], s_WaterCount);
        }
    }
    barrier();
    
    if (!hasFaces || faceCount == 0u) return;
    
    // Now allocate local space within the workgroup block
    // We need to know our offset within the workgroup.
    // We can't use atomicAdd on shared memory again because we need the prefix sum.
    // But since we only have max 6 faces, we can just use atomicAdd on shared memory again?
    // No, that would give us a new count, not an offset.
    // We need a prefix sum or just use atomicAdd on a separate counter.
    // Let's use a separate counter for allocation.
    // We can reuse s_OpaqueCount and s_WaterCount as "current offset" counters if we reset them?
    // No, that's racey.
    // Let's just use atomicAdd on s_OpaqueBase/s_WaterBase?
    // No, s_OpaqueBase is the global base.
    // We need a local offset.
    // Let's use atomicAdd on s_OpaqueCount/s_WaterCount again, but starting from 0?
    // Yes.
    
    // Re-initialize counters for distribution
    // We need a second barrier.
    // But we can't re-init s_OpaqueCount because other threads might still be reading it?
    // We passed a barrier.
    // But we need the TOTAL count for the leader thread.
    // We already did that.
    
    // So:
    // 1. Count faces -> s_OpaqueCount (Total)
    // 2. Leader allocates global -> s_OpaqueBase (Global Base)
    // 3. Reset s_OpaqueCount = 0
    // 4. Threads atomicAdd(s_OpaqueCount, faces) -> Local Offset
    // 5. Global Index = s_OpaqueBase + Local Offset
    
    // We need another barrier after leader allocation.
    // And we need to reset counters.
    
    // Wait, we can't reset s_OpaqueCount safely if we use it for allocation.
    // We need separate counters for "Total" and "Current".
    // Or just use atomicAdd on a new shared variable.
    // Let's define s_OpaqueCurrent.
    
    // Actually, we can just use atomicAdd on s_OpaqueBase!
    // s_OpaqueBase holds the Global Base.
    // If we atomicAdd(s_OpaqueBase, faces), we get the OLD value, which is our Global Index!
    // And s_OpaqueBase increments.
    // But s_OpaqueBase is shared.
    // So all threads in workgroup increment it.
    // At the end, s_OpaqueBase will be GlobalBase + Total.
    // This is fine! We don't need the original GlobalBase anymore.
    
    uint localFaceIdx;
    if (isWater) {
        // Offset by opaque count for water
        uint opaqueChunkCount = opaqueCounts[chunkIdx];
        // Safety check: prevent overflow if counts disagree
        // We don't have total water count here easily, but we can check against buffer limits?
        // No, just trust for now, but maybe clamp?
        localFaceIdx = opaqueChunkCount + atomicAdd(s_WaterBase, faceCount);
    } else {
        localFaceIdx = atomicAdd(s_OpaqueBase, faceCount);
        
        // Safety check: if we exceed opaque count, we are overwriting water or next chunk!
        // This indicates a mismatch between count and compact shaders.
        // For now, let's just drop the face if it overflows.
        uint opaqueChunkCount = opaqueCounts[chunkIdx];
        if (localFaceIdx >= opaqueChunkCount) {
            // Overflow!
            // We can't easily "undo" the atomicAdd.
            // But we can skip writing.
            // However, s_OpaqueBase is shared, so subsequent threads are also offset.
            // This means the whole workgroup might be offset.
            // We should probably continue to write to avoid holes, but clamp to safe area?
            // No, writing to wrong area is worse.
            // Let's just skip writing.
            return;
        }
    }
    
    // ... (rest of writing logic)
    
    uint vertexChunkBase = baseOffsets[chunkIdx];
    uint indexChunkBase  = (vertexChunkBase / 4u) * 6u;
    
    vec3 voxelPos = chunkWorldOffset + vec3(float(lx),float(ly),float(lz));
    
    // Iterate faces and write
    // Note: We allocated 'faceCount' slots.
    // We need to write them sequentially.
    // But the loop iterates 6 faces.
    // We need to know which slot corresponds to which face.
    // atomicAdd gave us the start index for ALL faces of this voxel.
    // So we just increment.
    
    uint currentFaceOffset = 0u;
    
    for(uint face=0u; face<6u; face++){
        uint faceBit=1u<<face;
        if((mask & faceBit)==0u) continue;
        
        uint finalFaceIdx = localFaceIdx + currentFaceOffset;
        currentFaceOffset++;
        
        uint vertBaseAbs = uVertexRegionOffset + vertexChunkBase + finalFaceIdx*4u;
        uint idxWriteBase = uIndexRegionOffset + indexChunkBase + finalFaceIdx*6u;
        
        // ... (write vertex/index)
        vec3 corners[4];
        getFaceCorners(face, voxelPos, corners);
        uint facePacked = face | (blockType << 8);

        for(uint v=0u; v<4u; v++){
            vec2 uv;
            if (isWater) {
                uv = flipV(getBaseUV(v));
            } else {
                uv = getAtlasUV(face,v);
            }
            
            float ao=calculateAO(face,v,chunkIdx,chunkWorldOffset,ivec3(lx,ly,lz));
            writeVertex(vertBaseAbs+v,corners[v],uv,ao,facePacked);
        }
        uint localVertBase = finalFaceIdx*4u;
        compactIndices[idxWriteBase+0u]=localVertBase+0u;
        compactIndices[idxWriteBase+1u]=localVertBase+1u;
        compactIndices[idxWriteBase+2u]=localVertBase+2u;
        compactIndices[idxWriteBase+3u]=localVertBase+2u;
        compactIndices[idxWriteBase+4u]=localVertBase+3u;
        compactIndices[idxWriteBase+5u]=localVertBase+0u;
    }
}
