#version 460

layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(std430, binding = 0) buffer ssbo_height { float height[]; };
layout(std430, binding = 1) buffer ssbo_blocktypes { uint blocktype[]; };
layout(std430, binding = 2) buffer ssbo_chunk_indices { uint chunkIndices[]; };
layout(std430, binding = 3) buffer ssbo_column_heights { uint columnHeights[]; };
layout(std430, binding = 4) buffer ssbo_blockattrib { uint blockAttribs[]; };

uniform int chunkSize;
uniform int chunkYSize;
uniform int waterLevel;


const uint BlockTypeNone = 0u;
const uint BlockTypeWaterLevel = 1u;
const uint BlockTypeRock = 2u;
const uint BlockTypeSand = 3u;
const uint BlockTypeDirt = 4u;
const uint BlockTypeGrassDirt = 5u;
const uint BlockTypeGrass = 6u;
const uint BlockTypeSnow = 7u;
const uint BlockTypeBedRock = 8u;
const uint BlockTypeGravel = 9u;

float GetHeight(uint chunkIdx, uint lx, uint lz) {
    uint chunkArea = uint(chunkSize * chunkSize);
    uint baseIndex = chunkIdx * chunkArea;
    return height[baseIndex + lx + lz * uint(chunkSize)];
}

uint CalcBlockType(int maxHeight, uint x, uint y, uint z) {
    uint blockAltitude = y;
    uint bt;
    if (blockAltitude > uint(maxHeight))                                       bt = BlockTypeNone;
    else if (blockAltitude == uint(maxHeight))                                 bt = BlockTypeGrassDirt;
    else if (blockAltitude < maxHeight && blockAltitude >= uint(maxHeight) - 2)bt = BlockTypeDirt;
    else if (blockAltitude < uint(maxHeight) - 2)                              bt = BlockTypeRock;

    if (blockAltitude <= uint(waterLevel)) {
        if (bt == BlockTypeNone && blockAltitude == uint(waterLevel))           bt = BlockTypeWaterLevel;
        else if (bt != BlockTypeNone && blockAltitude + 1u >= uint(waterLevel)) bt = BlockTypeSand;
        else if (bt != BlockTypeNone && blockAltitude + 1u <  uint(waterLevel)) bt = BlockTypeBedRock;
        else if (blockAltitude < 3u)                                            bt = BlockTypeBedRock;
    }

    return bt;
}

bool IsRenderable(uint type) { return type != BlockTypeNone; }
bool Occludes(uint type) { return type != BlockTypeNone && type != BlockTypeWaterLevel; }

bool OccludesAt(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    if (x < 0 || x >= chunkSize || z < 0 || z >= chunkSize) return true;
    if (y < 0) return true;
    if (y >= chunkYSize) return false;
    uint idx = uint(x) + uint(z) * uint(chunkSize) + uint(y) * chunkArea;
    uint type = blocktype[baseIndex + idx];
    return Occludes(type);
}

bool TransparentAt(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    return !OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y, z);
}

uint ToAo(uint occluders) {
    return min(occluders * 4u, 15u);
}

uint PackAo(uint east, uint west, uint up, uint down, uint south, uint north) {
    return (east & 0xFu)
        | ((west & 0xFu) << 4)
        | ((up & 0xFu) << 8)
        | ((down & 0xFu) << 12)
        | ((south & 0xFu) << 16)
        | ((north & 0xFu) << 20);
}

uint FaceAoEast(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y, z - 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y - 1, z)) count++;
    return ToAo(count);
}

uint FaceAoWest(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y, z - 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y - 1, z)) count++;
    return ToAo(count);
}

uint FaceAoUp(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y + 1, z) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y + 2, z)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y + 1, z) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y + 2, z)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y + 1, z + 1) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y + 2, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y + 1, z - 1) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y + 2, z - 1)) count++;
    return ToAo(count);
}

uint FaceAoDown(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y - 1, z) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y - 2, z)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y - 1, z) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y - 2, z)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 1, z + 1) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 2, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 1, z - 1) || OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 2, z - 1)) count++;
    return ToAo(count);
}

uint FaceAoSouth(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y, z + 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 1, z + 1)) count++;
    return ToAo(count);
}

uint FaceAoNorth(uint baseIndex, int chunkSize, int chunkYSize, uint chunkArea, int x, int y, int z) {
    uint count = 0u;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x + 1, y, z - 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x - 1, y, z - 1)) count++;
    if (OccludesAt(baseIndex, chunkSize, chunkYSize, chunkArea, x, y - 1, z - 1)) count++;
    return ToAo(count);
}

void main() { 
    
    uint lx = gl_LocalInvocationID.x;   // chunk local X
    uint lz = gl_LocalInvocationID.y;   // chunk local Z

    if (lx >= uint(chunkSize) || lz >= uint(chunkSize)) {
        return;
    }

    uint group = gl_WorkGroupID.x;                      // 0..N-1 of this dispatch
    float h = GetHeight(group, lx, lz);
    int normalizedHeight = int(round( h * float(chunkYSize - 1) ));
    normalizedHeight = clamp(normalizedHeight, 0, chunkYSize - 1);
    uint chunkArea = uint(chunkSize * chunkSize);
    uint voxelCount = chunkArea * uint(chunkYSize);
    uint base = gl_WorkGroupID.x * voxelCount;  //  packed per-dispatch
    uint heightBase = gl_WorkGroupID.x * chunkArea;
    columnHeights[heightBase + lz * uint(chunkSize) + lx] = uint(normalizedHeight);

    for (int y = chunkYSize - 1; y >= 0; --y) {
        uint blockIdx = lx + lz * uint(chunkSize) + uint(y) * chunkArea;
        uint bt = CalcBlockType(normalizedHeight, lx, uint(y), lz);
        blocktype[base + blockIdx] = bt; 
    }

    memoryBarrierBuffer();
    barrier();

    int ix = int(lx);
    int iz = int(lz);

    for (int y = chunkYSize - 1; y >= 0; --y) {
        uint blockIdx = lx + lz * uint(chunkSize) + uint(y) * chunkArea;
        uint rawType = blocktype[base + blockIdx];

        if (!IsRenderable(rawType)) {
            blockAttribs[base + blockIdx] = 0u;
            continue;
        }

        bool eastTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix + 1, y, iz);
        bool westTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix - 1, y, iz);
        bool upTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix, y + 1, iz);
        bool downTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix, y - 1, iz);
        bool southTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix, y, iz + 1);
        bool northTrans = TransparentAt(base, chunkSize, chunkYSize, chunkArea, ix, y, iz - 1);

        bool visible = eastTrans || westTrans || upTrans || downTrans || southTrans || northTrans;

        if (y == 0 && rawType == BlockTypeBedRock) {
            visible = false;
        }

        uint aoEast = 0u;
        uint aoWest = 0u;
        uint aoUp = 0u;
        uint aoDown = 0u;
        uint aoSouth = 0u;
        uint aoNorth = 0u;

        if (visible) {
            aoEast = FaceAoEast(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
            aoWest = FaceAoWest(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
            aoUp = FaceAoUp(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
            aoDown = FaceAoDown(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
            aoSouth = FaceAoSouth(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
            aoNorth = FaceAoNorth(base, chunkSize, chunkYSize, chunkArea, ix, y, iz);
        }

        uint packedAo = visible ? PackAo(aoEast, aoWest, aoUp, aoDown, aoSouth, aoNorth) : 0u;
        uint attrib = (packedAo << 1) | (visible ? 1u : 0u);
        blockAttribs[base + blockIdx] = attrib;
    }
} 
