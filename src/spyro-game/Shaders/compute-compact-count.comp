#version 460

layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(std430, binding = 1) readonly buffer ssbo_blocktypes { uint blocktype[]; };
layout(std430, binding = 4) readonly buffer ssbo_blockattrib { uint blockAttribs[]; };
layout(std430, binding = 6) buffer ssbo_counts { int counts[]; };
// Primary index -> group index in blocktype/attrib buffers for this dispatch
layout(std430, binding = 13) readonly buffer ssbo_remap { int remap[]; };
// Column heights per chunk (written in compute-chunk)
// Optional per-voxel break mask bitset (1 = hidden, 0 = visible), packed 32 voxels per uint
layout(std430, binding = 16) readonly buffer ssbo_breakMask3D { uint breakMask3D[]; };

uniform int chunkSize;
uniform int chunkYSize;
uniform int waterBlockType; // skip water voxels (rendered by separate water node)

uint ChunkArea() { return uint(chunkSize * chunkSize); }
uint ChunkVoxelCount() { return ChunkArea() * uint(chunkYSize); }

void main()
{
    uint lx = gl_LocalInvocationID.x;
    uint lz = gl_LocalInvocationID.y;
    if (lx >= uint(chunkSize) || lz >= uint(chunkSize)) return;

    uint group = gl_WorkGroupID.x;
    // Map primary group (0..N-1) to the source group in block arrays (may be padded ordering)
    uint groupMapped = uint(remap[group]);
    uint base = groupMapped * ChunkVoxelCount();
    uint area = ChunkArea();

    // Count all visible voxels (attrib bit set), skip water and broken voxels (3D bitset)
    int localCount = 0;
    uint wordsPerChunk = (ChunkVoxelCount() + 31u) / 32u;
    for (int y = 0; y < chunkYSize; ++y)
    {
        uint idx = lx + lz * uint(chunkSize) + uint(y) * area;
        uint word = idx >> 5u;
        uint bit = 1u << (idx & 31u);
        // Break mask already applied in compute-chunk when building attribs; ignore here to avoid double-masking
        uint broken = 0u;
        uint attrib = blockAttribs[base + idx];
        if ((attrib & 1u) == 0u) continue;
        uint bt = blocktype[base + idx];
        if (int(bt) == waterBlockType) continue;
        localCount++;
    }
    if (localCount > 0) atomicAdd(counts[group], localCount);
}
