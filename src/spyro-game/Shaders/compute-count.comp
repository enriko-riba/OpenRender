#version 460
#include "terrain-common.glsl"

// Counts total visible faces and opaque (non-water) faces per chunk layer
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

uniform uint uChunkCount;

layout(std430, binding = 0) readonly buffer VoxelData { uint voxelData[]; };
layout(std430, binding = 1) readonly buffer VisibilityMask { uint visibilityMask[]; };
layout(std430, binding = 2) buffer VisibleCounts { uint visibleCounts[]; };
layout(std430, binding = 12) buffer OpaqueCounts { uint opaqueCounts[]; };

shared uint s_TotalCount;
shared uint s_OpaqueCount;

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    uint ly = gl_WorkGroupID.y; // 0..383
    
    if (chunkIdx >= uChunkCount || ly >= uint(CHUNK_Y_SIZE)) return;
    
    // Initialize shared
    if (gl_LocalInvocationIndex == 0u) {
        s_TotalCount = 0u;
        s_OpaqueCount = 0u;
    }
    barrier();
    
    // Each thread processes 4 voxels in this Y layer (256 voxels / 64 threads)
    uint lx_base = gl_LocalInvocationID.x * 4u;
    
    uint tCount = 0u;
    uint oCount = 0u;
    
    // Calculate global voxel index base for this thread's 4 voxels
    // voxelIdx = chunk * VOXELS + ly * SIDE*SIDE + lx_base
    uint voxelIdx = chunkIdx * uint(CHUNK_VOXEL_COUNT) + ly * uint(CHUNK_SIDE_SIZE_SQUARED) + lx_base;
    
    // OPTIMIZATION: Read packed visibility mask once for 4 voxels
    uint packedMask = visibilityMask[voxelIdx >> 2];
    
    if (packedMask != 0u) {
        for (uint i = 0u; i < 4u; i++) {
            // Extract mask for this voxel
            uint mask = (packedMask >> (i * 8u)) & 0xFFu;
            
            if (mask != 0u) {
                uint faces = uint(bitCount(mask & 0x3Fu));
                tCount += faces;
                
                // We need to read voxel data to check for water
                // Voxel data is NOT packed (still 32 bits per voxel)
                uint currentVoxelIdx = voxelIdx + i;
                uint voxel = voxelData[currentVoxelIdx];
                uint blockDescriptor = voxel & 0xFFu;
                
                // Count opaque faces (exclude water)
                if (blockDescriptor != BD_WATER) {
                    oCount += faces;
                }
            }
        }
    }
    
    if (tCount > 0u) atomicAdd(s_TotalCount, tCount);
    if (oCount > 0u) atomicAdd(s_OpaqueCount, oCount);
    
    barrier();
    
    // Leader adds to global counts
    if (gl_LocalInvocationIndex == 0u) {
        if (s_TotalCount > 0u) atomicAdd(visibleCounts[chunkIdx], s_TotalCount);
        if (s_OpaqueCount > 0u) atomicAdd(opaqueCounts[chunkIdx], s_OpaqueCount);
    }
}
