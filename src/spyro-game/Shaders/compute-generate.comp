#version 460
#extension GL_ARB_gpu_shader_int64 : require

#include "terrain-common.glsl"
#include "terrain-noise.glsl"
#include "terrain-caves.glsl"
#include "terrain-generation.glsl"
#include "terrain-biomes.glsl"

// Generation packs 4 X columns per local invocation (local_size_x=4). Visibility must NOT match this packing; it needs 16 to touch every column.
layout(local_size_x = 4, local_size_y = 1, local_size_z = 16) in;

// Uniforms
uniform uint uChunkCount;
uniform uint uWorldChunksXZ;
// uniform int uTestMode = 0; // Removed

// SSBOs
layout(std430, binding = 9) readonly buffer ChunkIndicesBuffer {
    uint chunkIndices[];
};

layout(std430, binding = 0) writeonly buffer VoxelDataBuffer {
    uint voxelData[];
};

layout(std430, binding = 2) writeonly buffer ColumnHeightsBuffer {
    int columnHeights[];
};

layout(std430, binding = 3) writeonly buffer ColumnMetaBuffer {
    uvec4 columnMeta[];
};

uint packVoxel(uint blockType) {
    return blockType | (0u << 8) | (15u << 16) | (0u << 24);
}

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    uint ly = gl_WorkGroupID.y; // 0..383
    
    if (chunkIdx >= uChunkCount || ly >= uint(CHUNK_Y_SIZE)) return;
    
    uint lx_packed = gl_LocalInvocationID.x; // 0..3
    uint lz = gl_LocalInvocationID.z;
    uint chunkIndexGlobal = chunkIndices[chunkIdx];
    uint chunkX = chunkIndexGlobal % uWorldChunksXZ;
    uint chunkZ = chunkIndexGlobal / uWorldChunksXZ;
    
    // Base voxel index for this column group (4 columns)
    // Voxel layout: Chunk -> Y -> Z -> X
    // We process 4 X-neighbors at once
    uint lx_base = lx_packed * 4u;
    
    int wx_base = int(chunkX * CHUNK_SIDE_SIZE + lx_base);
    int wz = int(chunkZ * CHUNK_SIDE_SIZE + lz);

    // Calculate heights for 4 columns
    // We need heights for block generation in every layer
    int heights[4];
    for (int i = 0; i < 4; i++) {
        heights[i] = generateHeight(wx_base + i, wz);
        
        // Write column metadata ONLY in the first layer to avoid race conditions
        if (ly == 0u) {
            uint columnIdx = chunkIdx * CHUNK_SIDE_SIZE_SQUARED + lz * CHUNK_SIDE_SIZE + (lx_base + i);
            columnHeights[columnIdx] = heights[i];
            columnMeta[columnIdx] = uvec4(0, 0, 0, 0);
        }
    }

    // Base index for voxel data (points to the start of the packed uint array for this chunk/z/x_base)
    // Voxel index = chunk * VOXELS + y * SIDE*SIDE + z * SIDE + lx_packed
    
    uint packedChunkOffset = chunkIdx * uint(PACKED_CHUNK_VOXEL_COUNT);
    uint packedZOffset = lz * uint(CHUNK_SIDE_SIZE);
    uint packedYStride = uint(CHUNK_SIDE_SIZE_SQUARED); // 256

    // Process single Y layer
    for (int i = 0; i < 4; i++) {
        uint blockType = generateBlockType(heights[i], int(ly), wx_base + i, wz);
        
        // Ensure bits 8-31 are cleared (Biome, Light, Flags)
        // Light (bits 16-23) must be 0 for the lighting pass to work correctly
        uint packedVoxel = blockType & 0xFFu;
        
        uint packedIdx = packedChunkOffset + uint(ly) * packedYStride + packedZOffset + (lx_base + i);
        voxelData[packedIdx] = packedVoxel;
    }
}

