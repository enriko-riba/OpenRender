#version 460
#include "terrain-common.glsl"

// Expect dispatch groups (chunkCount, CHUNK_Y_SIZE, 1). If Y dimension < CHUNK_Y_SIZE counts will be truncated.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

uniform uint uChunkCount;

layout(std430, binding = 0) readonly buffer VoxelData { uint voxelData[]; };
layout(std430, binding = 1) readonly buffer VisibilityMask { uint visibilityMask[]; };
layout(std430, binding = 2) buffer VisibleCounts { uint visibleCounts[]; };
layout(std430, binding = 12) buffer OpaqueCounts { uint opaqueCounts[]; };

shared uint s_TotalCount;
shared uint s_OpaqueCount;

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    uint ly = gl_WorkGroupID.y; // 0..383
    
    if (chunkIdx >= uChunkCount || ly >= uint(CHUNK_Y_SIZE)) return;
    
    // Initialize shared
    if (gl_LocalInvocationIndex == 0u) {
        s_TotalCount = 0u;
        s_OpaqueCount = 0u;
    }
    barrier();
    
    // Each thread processes one voxel in this layer
    // Layer size = 16*16 voxels = 256 voxels.
    // local_size_x = 64.
    // So each thread processes 4 voxels (256/64 = 4).
    
    uint lx_base = gl_LocalInvocationID.x * 4u; // 0, 4, 8... 252
    
    uint tCount = 0u;
    uint oCount = 0u;
    
    for (uint i = 0u; i < 4u; i++) {
        uint lx = lx_base + i;
        // Calculate global voxel index
        // voxelIdx = chunk * VOXELS + ly * SIDE*SIDE + lx (where lx is 0..255 linear index in layer)
        // Wait, lx here is linear index in layer (0..255).
        // But lx in other shaders is X coordinate (0..15).
        // Here we treat the layer as a linear array of 256 voxels.
        
        uint voxelIdx = chunkIdx * uint(CHUNK_VOXEL_COUNT) + ly * uint(CHUNK_SIDE_SIZE_SQUARED) + lx;
        
        uint mask = visibilityMask[voxelIdx];
        
        if (mask != 0u) {
            uint faces = uint(bitCount(mask & 0x3Fu));
            tCount += faces;
            
            uint voxel = voxelData[voxelIdx];
            uint blockType = voxel & 0xFFu;
            
            if (blockType != BLOCK_WATER_LEVEL) {
                oCount += faces;
            }
        }
    }
    
    if (tCount > 0u) atomicAdd(s_TotalCount, tCount);
    if (oCount > 0u) atomicAdd(s_OpaqueCount, oCount);
    
    barrier();
    
    // Leader adds to global counts
    if (gl_LocalInvocationIndex == 0u) {
        if (s_TotalCount > 0u) atomicAdd(visibleCounts[chunkIdx], s_TotalCount);
        if (s_OpaqueCount > 0u) atomicAdd(opaqueCounts[chunkIdx], s_OpaqueCount);
    }
}
