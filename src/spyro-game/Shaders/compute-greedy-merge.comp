#version 460
// compute-greedy-merge.comp - Phase GM-1: Greedy Meshing
// Purpose: Merge adjacent co-planar faces of same type into larger quads
// Version: 1.1 (Fix coplanar axes)
//
// Algorithm: Row-based greedy expansion
// - Each thread processes one row in a layer
// - Expands X-axis first, then Z-axis (2D greedy)
// - Uses shared memory for fast layer processing

#include "terrain-common.glsl"
#include "terrain-greedy-meshing.glsl"

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

const uint FACE_POS_X = 0u;
const uint FACE_NEG_X = 1u;
const uint FACE_POS_Y = 2u;
const uint FACE_NEG_Y = 3u;
const uint FACE_POS_Z = 4u;
const uint FACE_NEG_Z = 5u;

uniform uint uChunkCount;

layout(std430, binding = 0) readonly buffer VoxelData { uint voxelData[]; };
layout(std430, binding = 1) readonly buffer VisibilityMask { uint visibilityMask[]; };
layout(std430, binding = 10) writeonly buffer MergedQuads { uint mergedQuads[]; };
layout(std430, binding = 11) buffer QuadCounts { uint quadCounts[]; };

shared uint s_mask[256];
shared uint s_types[256];
shared uint s_consumed[256];

bool canMerge(uint idx1, uint idx2, uint faceBit) {
    if ((s_mask[idx1] & faceBit) == 0u || (s_mask[idx2] & faceBit) == 0u) return false;
    if ((s_consumed[idx1] & faceBit) != 0u || (s_consumed[idx2] & faceBit) != 0u) return false;
    return s_types[idx1] == s_types[idx2];
}

void markConsumed(uint idx, uint faceBit) { atomicOr(s_consumed[idx], faceBit); }

void emitQuad(uint chunkIdx, uint startX, uint startY, uint startZ, uint extentX, uint extentZ, uint face, uint blockType) {
    uint slot = atomicAdd(quadCounts[chunkIdx], 1u);
    const uint maxQuadsPerChunk = CHUNK_VOXEL_COUNT * 6u;
    uint globalQuadIdx = chunkIdx * maxQuadsPerChunk + slot;
    ivec3 start = ivec3(startX, startY, startZ);
    uint ao0=4u, ao1=4u, ao2=4u, ao3=4u;
    uint packed1 = packQuad1(start, face, extentX, extentZ);
    uint packed2 = packQuad2(blockType, ao0, ao1, ao2, ao3);
    mergedQuads[globalQuadIdx * 2u + 0u] = packed1;
    mergedQuads[globalQuadIdx * 2u + 1u] = packed2;
}

void greedyMergeFacesX(uint chunkIdx, uint ly, uint colX, uint faceBit) {
    // One thread per X column; merge along Z only (coplanar X faces)
    uint lx = colX;
    uint lz = 0u;
    while (lz < CHUNK_SIDE_SIZE) {
        // Axis-0/1 mapping uses (rowIdx=lz, col=lx) -> idx = lz*SIDE + lx
        uint idx = lz * CHUNK_SIDE_SIZE + lx;
        bool visible = (s_mask[idx] & faceBit) != 0u && (s_consumed[idx] & faceBit) == 0u;
        if (!visible) { lz++; continue; }
        uint startZ = lz;
        uint blockType = s_types[idx];
        uint run = 1u;
        while ((startZ + run) < CHUNK_SIDE_SIZE) {
            uint nextIdx = (startZ + run) * CHUNK_SIDE_SIZE + lx;
            if (!canMerge(idx, nextIdx, faceBit)) break;
            run++;
        }
        for (uint z = 0u; z < run; z++) { uint cIdx = (startZ + z) * CHUNK_SIDE_SIZE + lx; markConsumed(cIdx, faceBit); }
        uint face = (faceBit == (1u << 0)) ? FACE_POS_X : FACE_NEG_X;
        emitQuad(chunkIdx, lx, ly, startZ, 1u, run, face, blockType);
        lz = startZ + run;
    }
}

void greedyMergeFacesY(uint chunkIdx, uint ly, uint rowIdx, uint faceBit) {
    for (uint lz = 0u; lz < CHUNK_SIDE_SIZE; lz++) {
        for (uint lx = 0u; lx < CHUNK_SIDE_SIZE; lx++) {
            uint idx = lz * CHUNK_SIDE_SIZE + lx;
            if ((s_mask[idx] & faceBit) == 0u || (s_consumed[idx] & faceBit) != 0u) continue;
            uint startX = lx; uint startZ = lz; uint blockType = s_types[idx];
            uint extentX = 1u; while (startX + extentX < CHUNK_SIDE_SIZE) { uint nextIdx = lz * CHUNK_SIDE_SIZE + (startX + extentX); if (!canMerge(idx, nextIdx, faceBit)) break; extentX++; }
            uint extentZ = 1u; bool canExpand = true; while (startZ + extentZ < CHUNK_SIDE_SIZE && canExpand) { for (uint x=0u;x<extentX;x++){ uint checkIdx=(startZ+extentZ)*CHUNK_SIDE_SIZE+(startX+x); if(!canMerge(idx,checkIdx,faceBit)){ canExpand=false; break; } } if (canExpand) extentZ++; }
            for (uint z=0u; z<extentZ; z++){ for (uint x=0u; x<extentX; x++){ uint cIdx=(startZ+z)*CHUNK_SIDE_SIZE+(startX+x); markConsumed(cIdx, faceBit);} }
            uint face = (faceBit == (1u<<2)) ? FACE_POS_Y : FACE_NEG_Y;
            emitQuad(chunkIdx, startX, ly, startZ, extentX, extentZ, face, blockType);
        }
    }
}

void greedyMergeFacesZ(uint chunkIdx, uint ly, uint rowZ, uint faceBit) {
    // One thread per Z row; merge along X only (coplanar Z faces)
    uint lz = rowZ;
    uint lx = 0u;
    while (lx < CHUNK_SIDE_SIZE) {
        // Axis-2 shared memory mapping uses (rowIdx=lx, col=lz) -> idx = lx*SIDE + lz
        uint idx = lx * CHUNK_SIDE_SIZE + lz;
        bool visible = (s_mask[idx] & faceBit) != 0u && (s_consumed[idx] & faceBit) == 0u;
        if (!visible) { lx++; continue; }
        uint startX = lx;
        uint blockType = s_types[idx];
        uint run = 1u;
        while ((startX + run) < CHUNK_SIDE_SIZE) {
            uint nextIdx = (startX + run) * CHUNK_SIDE_SIZE + lz;
            if (!canMerge(idx, nextIdx, faceBit)) break;
            run++;
        }
        for (uint x=0u; x<run; x++){ uint cIdx = (startX + x) * CHUNK_SIDE_SIZE + lz; markConsumed(cIdx, faceBit); }
        uint face = (faceBit == (1u<<4)) ? FACE_POS_Z : FACE_NEG_Z;
        emitQuad(chunkIdx, startX, ly, lz, run, 1u, face, blockType);
        lx = startX + run;
    }
}

void main(){
    uint chunkIdx = gl_WorkGroupID.x; if (chunkIdx >= uChunkCount) return; uint ly = gl_WorkGroupID.y; uint axis = gl_WorkGroupID.z; uint rowIdx = gl_LocalInvocationID.x;
    // Load layer data
    for (uint col=0u; col<CHUNK_SIDE_SIZE; col++){
        uint lx, lz; if (axis==0u || axis==1u){ lx = col; lz = rowIdx; } else { lx = rowIdx; lz = col; }
        uint voxelIdx = chunkIdx * uint(CHUNK_VOXEL_COUNT) + lx + lz * uint(CHUNK_SIDE_SIZE) + ly * uint(CHUNK_SIDE_SIZE_SQUARED);
        uint sharedIdx = rowIdx * CHUNK_SIDE_SIZE + col;
        s_mask[sharedIdx] = getPackedVisMask(voxelIdx, visibilityMask);
        s_types[sharedIdx] = voxelData[voxelIdx] & 0xFFu;
        s_consumed[sharedIdx] = 0u;
    }
    barrier();

    if (axis == 0u) {
        // +X faces then -X
        greedyMergeFacesX(chunkIdx, ly, rowIdx, 1u<<0); barrier(); greedyMergeFacesX(chunkIdx, ly, rowIdx, 1u<<1);
    } else if (axis == 1u) {
        if (rowIdx == 0u) { greedyMergeFacesY(chunkIdx, ly, rowIdx, 1u<<2); greedyMergeFacesY(chunkIdx, ly, rowIdx, 1u<<3); }
    } else {
        greedyMergeFacesZ(chunkIdx, ly, rowIdx, 1u<<4); barrier(); greedyMergeFacesZ(chunkIdx, ly, rowIdx, 1u<<5);
    }
}
