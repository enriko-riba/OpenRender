#version 460
layout(local_size_x = 16, local_size_y = 1, local_size_z = 16) in;

const int CHUNK_SIDE_SIZE = 16;
const int CHUNK_Y_SIZE = 128;
const int MAX_SPANS = 16;

struct ColumnSpans {
    uint count;
    uint spans[MAX_SPANS]; // Packed: Start(8) | End(8) | Type(8) | Unused(8)
};

layout(std430, binding = 1) readonly buffer VoxelDataBuffer {
    uint voxelData[];
};

layout(std430, binding = 4) writeonly buffer ColumnSpansBuffer {
    ColumnSpans columnSpans[];
};

uniform uint uChunkCount;

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    if (chunkIdx >= uChunkCount) return;

    uint lx = gl_LocalInvocationID.x;
    uint lz = gl_LocalInvocationID.z;
    
    // Voxel data layout: chunk -> y -> z -> x? No, wait.
    // compute-generate.comp: voxelIdx = voxelBaseIdx + y * CHUNK_SIDE_SIZE_SQUARED;
    // voxelBaseIdx = chunkIdx * CHUNK_VOXEL_COUNT + lz * CHUNK_SIDE_SIZE + lx;
    // So it is Chunk -> Y -> Z -> X? No.
    // voxelBaseIdx depends on lx, lz.
    // voxelIdx = base + y * 256.
    // So for a given (lx, lz), the voxels are at stride 256.
    
    uint voxelBaseIdx = chunkIdx * (CHUNK_SIDE_SIZE * CHUNK_SIDE_SIZE * CHUNK_Y_SIZE) + lz * CHUNK_SIDE_SIZE + lx;
    uint columnIdx = chunkIdx * (CHUNK_SIDE_SIZE * CHUNK_SIDE_SIZE) + lz * CHUNK_SIDE_SIZE + lx;

    uint currentStart = 0;
    uint currentType = 0; // 0 = Air
    uint spanCount = 0;
    bool inSpan = false;

    for (int y = 0; y < CHUNK_Y_SIZE; y++) {
        uint voxel = voxelData[voxelBaseIdx + y * (CHUNK_SIDE_SIZE * CHUNK_SIDE_SIZE)];
        uint type = voxel & 0xFF; // Extract block type

        if (type != 0) {
            if (!inSpan) {
                inSpan = true;
                currentStart = y;
                currentType = type;
            } else if (type != currentType) {
                // End current span, start new one
                if (spanCount < MAX_SPANS) {
                    uint start = currentStart & 0xFF;
                    uint end = uint(y - 1) & 0xFF;
                    uint bType = currentType & 0xFF;
                    uint packedSpan = start | (end << 8) | (bType << 16);
                    columnSpans[columnIdx].spans[spanCount] = packedSpan;
                    spanCount++;
                }
                currentStart = y;
                currentType = type;
            }
        } else {
            if (inSpan) {
                // End span
                if (spanCount < MAX_SPANS) {
                    uint start = currentStart & 0xFF;
                    uint end = uint(y - 1) & 0xFF;
                    uint bType = currentType & 0xFF;
                    uint packedSpan = start | (end << 8) | (bType << 16);
                    columnSpans[columnIdx].spans[spanCount] = packedSpan;
                    spanCount++;
                }
                inSpan = false;
            }
        }
    }
    
    // Close final span
    if (inSpan && spanCount < MAX_SPANS) {
        uint start = currentStart & 0xFF;
        uint end = uint(CHUNK_Y_SIZE - 1) & 0xFF;
        uint bType = currentType & 0xFF;
        uint packedSpan = start | (end << 8) | (bType << 16);
        columnSpans[columnIdx].spans[spanCount] = packedSpan;
        spanCount++;
    }

    columnSpans[columnIdx].count = spanCount;
}
