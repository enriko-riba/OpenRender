<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpyroGame</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Exclude old CPU-based implementation files from build -->
  <ItemGroup>
    <Compile Remove="MainScene.cs" />
    <Compile Remove="LoadingScene.cs" />
    <Compile Remove="LoadingScene2.cs" />
  </ItemGroup>

  <!-- Copy all shaders and resources to the output -->
  <ItemGroup>
    <Content Include="Resources\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Shaders\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- External/shared resources that live outside this project tree -->
  <ItemGroup>
    <Content Include="..\samples\shared_resources\consola.ttf" Link="Resources\consola.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\OpenRender\OpenRender.csproj" />
    <ProjectReference Include="..\TextRendering\TextRendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\voxel\Beach\" />
    <Folder Include="Resources\voxel\Desert\" />
    <Folder Include="Resources\voxel\Highlands\" />
    <Folder Include="Resources\voxel\Alpine\" />
    <Folder Include="Resources\voxel\Tundra\" />
    <Folder Include="Resources\voxel\Rainforest\" />
    <Folder Include="Resources\voxel\Savana\" />
  </ItemGroup>

</Project>
